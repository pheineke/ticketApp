<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fahrplan: "Mein Standort" as the origin. Asked for only when that button is used. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Tokens and the offline copy stay on this device: no cloud backup, no device transfer. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.MyVrn.Lite"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ConnectionActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.TicketActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Hochschul-Login (WebView). Handles rotation itself so the login page keeps its state. -->
        <activity
            android:name=".ui.DfnActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Saved invoices for a PDF viewer: not exported, readable only by a per-URI grant. -->
        <provider
            android:name=".data.InvoiceProvider"
            android:authorities="${applicationId}.invoices"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
