<?xml version="1.0" encoding="utf-8"?>
<!-- Fahrplan: full map with a draggable bottom sheet (search, results) and the long-press
     place card. On wide screens FahrplanPage turns the sheet into a side panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- RouteMap's MapView goes here. -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <de.skygazer.myvrnlite.ui.BottomSheet
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/sheet_grab"
            android:layout_width="match_parent"
            android:layout_height="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_grab" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/sheet_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sheet_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_pad"
                android:paddingEnd="@dimen/page_pad"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/search_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/pin_from"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginEnd="8dp" />

                                <FrameLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <AutoCompleteTextView
                                        android:id="@+id/from"
                                        style="@style/Field"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:completionThreshold="2"
                                        android:hint="@string/fp_from_hint"
                                        android:imeOptions="actionNext|flagNoExtractUi"
                                        android:inputType="textNoSuggestions"
                                        android:paddingEnd="44dp" />

                                    <ImageButton
                                        android:id="@+id/locate"
                                        style="@style/IconButton"
                                        android:layout_gravity="end|center_vertical"
                                        android:contentDescription="@string/fp_locate"
                                        android:src="@drawable/ic_locate" />
                                </FrameLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/pin_to"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginEnd="8dp" />

                                <AutoCompleteTextView
                                    android:id="@+id/to"
                                    style="@style/Field"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:completionThreshold="2"
                                    android:hint="@string/fp_to_hint"
                                    android:imeOptions="actionSearch|flagNoExtractUi"
                                    android:inputType="textNoSuggestions" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/swap"
                            style="@style/IconButton"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/fp_swap"
                            android:src="@drawable/ic_swap" />
                    </LinearLayout>

                    <!-- Ab/An, date, time, now: filled by FahrplanPage. -->
                    <FrameLayout
                        android:id="@+id/when_seg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/date"
                            style="@style/Button.Small.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4" />

                        <Button
                            android:id="@+id/time"
                            style="@style/Button.Small.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/now"
                            style="@style/Button.Small.Outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/fp_now" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/search"
                        style="@style/Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/fp_search" />
                </LinearLayout>

                <!-- Results, recent searches, hints: filled by FahrplanPage. -->
                <LinearLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </de.skygazer.myvrnlite.ui.BottomSheet>

    <!-- Long-press card: the place on the map, nearby stops, use as origin/destination. -->
    <LinearLayout
        android:id="@+id/place_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet_card"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pc_kind"
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/pc_name"
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/pc_close"
                style="@style/IconButton"
                android:contentDescription="@string/fp_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/pc_from"
                style="@style/Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fp_from_here" />

            <Button
                android:id="@+id/pc_to"
                style="@style/Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/fp_to_here" />
        </LinearLayout>

        <TextView
            android:id="@+id/pc_near_title"
            style="@style/Text.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/fp_nearby"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pc_stops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
