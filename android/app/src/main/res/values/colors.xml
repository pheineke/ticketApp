    <color name="vrn_tcard_body">#d9e2f1</color>
    <color name="vrn_tcard_ink">#002d59</color>
    <color name="vrn_ticket_line">#40002d59</color>

    <color name="lite_brand">#d80019</color>
    <color name="lite_brand_dark">#59000a</color>
    <color name="lite_brand_soft">#1fd80019</color>
    <color name="lite_brand_ink">#d80019</color>
    <color name="lite_accent_text">#59000a</color>
    <color name="vrn_brand">#0098d8</color>
    <color name="vrn_brand_dark">#002d59</color>
    <color name="vrn_brand_soft">#1f0098d8</color>
    <color name="vrn_brand_ink">#0098d8</color>
    <color name="vrn_accent_text">#002d59</color>

    <!-- Extra tokens (the Modern design uses them: lime for what is valid, the segment track,
         the inverted card); lite/vrn get matching values. -->
    <color name="lite_accent">#f1d9dc</color>
    <color name="lite_accent_ink">#59000a</color>
    <color name="lite_track">#faf0f1</color>
    <color name="lite_inverse">#59000a</color>
    <color name="lite_inverse_ink">#ffffff</color>
    <color name="vrn_accent">#d9e2f1</color>
    <color name="vrn_accent_ink">#002d59</color>
    <color name="vrn_track">#eef2f9</color>
    <color name="vrn_inverse">#002d59</color>
    <color name="vrn_inverse_ink">#ffffff</color>

