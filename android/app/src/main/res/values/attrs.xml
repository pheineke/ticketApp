<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette colours, set by Theme.MyVrn.Lite / Theme.MyVrn.Vrn (and their night variants). -->
    <attr name="brand" format="color" />
    <attr name="brandDark" format="color" />
    <attr name="brandSoft" format="color" />
    <!-- Brand colour for text and icons on surfaces (lighter in dark mode). -->
    <attr name="brandInk" format="color" />
    <!-- Headings and the app bar title (brand dark, white in dark mode). -->
    <attr name="accentText" format="color" />
    <!-- Page colours of the palette (light: white with the ink; dark: the ink as background). -->
    <attr name="cBg" format="color" />
    <attr name="cSurface" format="color" />
    <attr name="cText" format="color" />
    <attr name="cTextHeading" format="color" />
    <attr name="cTextMuted" format="color" />
    <attr name="cDivider" format="color" />
    <attr name="cHover" format="color" />
    <attr name="cCodeBg" format="color" />
    <attr name="cTcardTop" format="color" />
    <attr name="cTcardBody" format="color" />
    <attr name="cTcardInk" format="color" />
    <attr name="cTicketLine" format="color" />
    <attr name="cAccent" format="color" />
    <attr name="cAccentInk" format="color" />
    <attr name="cTrack" format="color" />
    <attr name="cInverse" format="color" />
    <attr name="cInverseInk" format="color" />
    <!-- Shapes per design: panels, buttons, inputs and bars (styles.xml refers to these). -->
    <attr name="dPanel" format="reference" />
    <attr name="dCard" format="reference" />
    <attr name="dBtnPrimary" format="reference" />
    <attr name="dBtnOutline" format="reference" />
    <attr name="dInput" format="reference" />
    <attr name="dAppBar" format="reference" />
    <attr name="dTabBar" format="reference" />
    <attr name="btnOutlineInk" format="color" />
    <attr name="btnMinHeight" format="dimension" />
    <attr name="btnTextSize" format="dimension" />
    <!-- Modern: large page titles, the logo, DM Sans (see Fonts.kt). -->
    <attr name="modernDesign" format="boolean" />
</resources>
