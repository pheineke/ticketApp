<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text" parent="android:Widget.TextView">
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Heading">
        <item name="android:textColor">?attr/cTextHeading</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Hint">
        <item name="android:textColor">?attr/cTextMuted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Section header: small, uppercase, muted (h2 in the web client). -->
    <style name="Text.Section">
        <item name="android:textColor">?attr/cTextMuted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Text.Link">
        <item name="android:textColor">?attr/brandInk</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Panel">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Button.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">?attr/brandInk</item>
    </style>

    <style name="Button.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Button.Small.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">?attr/brandInk</item>
    </style>

    <style name="Field" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textColorHint">?attr/cTextMuted</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="FieldLabel" parent="Text.Heading">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Slide-up card (InfoSheet): a dialog window at the bottom that slides in and out. -->
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
