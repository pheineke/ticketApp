<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light/dark is picked by the values-night override of these two. -->
    <style name="Platform.MyVrn" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Platform.MyVrn.Dialog" parent="android:Theme.Material.Light.Dialog.Alert" />

    <style name="Base.MyVrn" parent="Platform.MyVrn">
        <!-- Surface: what shows behind the bars when drawn edge to edge (Android 15+). -->
        <item name="android:windowBackground">?attr/cBg</item>
        <item name="android:colorBackground">?attr/cBg</item>
        <item name="android:textColorPrimary">?attr/cTextHeading</item>
        <item name="android:textColorSecondary">?attr/cTextMuted</item>
        <item name="android:textColorHint">?attr/cTextMuted</item>
        <item name="android:colorPrimary">?attr/brand</item>
        <item name="android:colorPrimaryDark">?attr/brandDark</item>
        <item name="android:colorAccent">?attr/brand</item>
        <item name="android:colorControlActivated">?attr/brand</item>
        <!-- Android 5.x can't draw dark status bar icons, so keep it dark there (BaseActivity lightens it on 6+). -->
        <item name="android:statusBarColor">?attr/brandDark</item>
        <item name="android:alertDialogTheme">@style/Dialog.MyVrn</item>
    </style>

    <style name="Theme.MyVrn.Lite" parent="Base.MyVrn">
        <item name="cAccent">@color/lite_accent</item>
        <item name="cAccentInk">@color/lite_accent_ink</item>
        <item name="cTrack">@color/lite_track</item>
        <item name="cInverse">@color/lite_inverse</item>
        <item name="cInverseInk">@color/lite_inverse_ink</item>
        <item name="dPanel">@drawable/bg_panel</item>
        <item name="dCard">@drawable/bg_card</item>
        <item name="dBtnPrimary">@drawable/btn_primary</item>
        <item name="dBtnOutline">@drawable/btn_outline</item>
        <item name="dInput">@drawable/bg_input</item>
        <item name="dAppBar">@drawable/bg_bar_bottom</item>
        <item name="dTabBar">@drawable/bg_bar_top</item>
        <item name="btnOutlineInk">?attr/brandInk</item>
        <item name="btnMinHeight">44dp</item>
        <item name="btnTextSize">15sp</item>
        <item name="modernDesign">false</item>
        <item name="cBg">@color/lite_bg</item>
        <item name="cSurface">@color/lite_surface</item>
        <item name="cText">@color/lite_text</item>
        <item name="cTextHeading">@color/lite_text_heading</item>
        <item name="cTextMuted">@color/lite_text_muted</item>
        <item name="cDivider">@color/lite_divider</item>
        <item name="cHover">@color/lite_hover</item>
        <item name="cCodeBg">@color/lite_code_bg</item>
        <item name="cTcardTop">@color/lite_tcard_top</item>
        <item name="cTcardBody">@color/lite_tcard_body</item>
        <item name="cTcardInk">@color/lite_tcard_ink</item>
        <item name="cTicketLine">@color/lite_ticket_line</item>
        <item name="brand">@color/lite_brand</item>
        <item name="brandDark">@color/lite_brand_dark</item>
        <item name="brandSoft">@color/lite_brand_soft</item>
        <item name="brandInk">@color/lite_brand_ink</item>
        <item name="accentText">@color/lite_accent_text</item>
    </style>

    <style name="Theme.MyVrn.Vrn" parent="Base.MyVrn">
        <item name="cAccent">@color/vrn_accent</item>
        <item name="cAccentInk">@color/vrn_accent_ink</item>
        <item name="cTrack">@color/vrn_track</item>
        <item name="cInverse">@color/vrn_inverse</item>
        <item name="cInverseInk">@color/vrn_inverse_ink</item>
        <item name="dPanel">@drawable/bg_panel</item>
        <item name="dCard">@drawable/bg_card</item>
        <item name="dBtnPrimary">@drawable/btn_primary</item>
        <item name="dBtnOutline">@drawable/btn_outline</item>
        <item name="dInput">@drawable/bg_input</item>
        <item name="dAppBar">@drawable/bg_bar_bottom</item>
        <item name="dTabBar">@drawable/bg_bar_top</item>
        <item name="btnOutlineInk">?attr/brandInk</item>
        <item name="btnMinHeight">44dp</item>
        <item name="btnTextSize">15sp</item>
        <item name="modernDesign">false</item>
        <item name="cBg">@color/vrn_bg</item>
        <item name="cSurface">@color/vrn_surface</item>
        <item name="cText">@color/vrn_text</item>
        <item name="cTextHeading">@color/vrn_text_heading</item>
        <item name="cTextMuted">@color/vrn_text_muted</item>
        <item name="cDivider">@color/vrn_divider</item>
        <item name="cHover">@color/vrn_hover</item>
        <item name="cCodeBg">@color/vrn_code_bg</item>
        <item name="cTcardTop">@color/vrn_tcard_top</item>
        <item name="cTcardBody">@color/vrn_tcard_body</item>
        <item name="cTcardInk">@color/vrn_tcard_ink</item>
        <item name="cTicketLine">@color/vrn_ticket_line</item>
        <item name="brand">@color/vrn_brand</item>
        <item name="brandDark">@color/vrn_brand_dark</item>
        <item name="brandSoft">@color/vrn_brand_soft</item>
        <item name="brandInk">@color/vrn_brand_ink</item>
        <item name="accentText">@color/vrn_accent_text</item>
    </style>

    <!-- Modern: its own design (Settings > Farben), with its own shapes and fonts. -->
    <style name="Theme.MyVrn.Modern" parent="Base.MyVrn">
        <item name="cBg">@color/modern_bg</item>
        <item name="cSurface">@color/modern_surface</item>
        <item name="cText">@color/modern_text</item>
        <item name="cTextHeading">@color/modern_text_heading</item>
        <item name="cTextMuted">@color/modern_text_muted</item>
        <item name="cDivider">@color/modern_divider</item>
        <item name="cHover">@color/modern_hover</item>
        <item name="cCodeBg">@color/modern_code_bg</item>
        <item name="cTcardTop">@color/modern_tcard_top</item>
        <item name="cTcardBody">@color/modern_tcard_body</item>
        <item name="cTcardInk">@color/modern_tcard_ink</item>
        <item name="cTicketLine">@color/modern_ticket_line</item>
        <item name="cAccent">@color/modern_accent</item>
        <item name="cAccentInk">@color/modern_accent_ink</item>
        <item name="cTrack">@color/modern_track</item>
        <item name="cInverse">@color/modern_inverse</item>
        <item name="cInverseInk">@color/modern_inverse_ink</item>
        <item name="brand">@color/modern_brand</item>
        <item name="brandDark">@color/modern_brand_dark</item>
        <item name="brandSoft">@color/modern_brand_soft</item>
        <item name="brandInk">@color/modern_brand_ink</item>
        <item name="accentText">@color/modern_accent_text</item>
        <item name="dPanel">@drawable/m_panel</item>
        <item name="dCard">@drawable/m_card</item>
        <item name="dBtnPrimary">@drawable/m_btn_primary</item>
        <item name="dBtnOutline">@drawable/m_btn_outline</item>
        <item name="dInput">@drawable/m_input</item>
        <item name="dAppBar">@drawable/m_app_bar</item>
        <item name="dTabBar">@drawable/m_tab_bar</item>
        <item name="btnOutlineInk">?attr/cTextHeading</item>
        <item name="btnMinHeight">52dp</item>
        <item name="btnTextSize">16sp</item>
        <item name="modernDesign">true</item>
    </style>

    <!-- Applied on top of the activity theme, so the palette attributes resolve here too. -->
    <style name="Dialog.MyVrn" parent="Platform.MyVrn.Dialog">
        <item name="android:colorAccent">?attr/brandInk</item>
    </style>
</resources>
