<?xml version="1.0" encoding="utf-8"?>
<!-- Surface card with a brand-coloured bar on the left. Built from insets because
     layer-list item width/gravity only exist from API 23. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/brand" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item android:left="3dp">
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:topRightRadius="@dimen/radius" android:bottomRightRadius="@dimen/radius" />
        </shape>
    </item>
</layer-list>
