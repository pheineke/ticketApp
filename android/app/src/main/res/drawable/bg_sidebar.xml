<?xml version="1.0" encoding="utf-8"?>
<!-- Permanent sidebar (wide screens): surface with a divider on its right edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/cDivider" />
        </shape>
    </item>
    <item android:right="1dp">
        <shape>
            <solid android:color="?attr/cSurface" />
        </shape>
    </item>
</layer-list>
