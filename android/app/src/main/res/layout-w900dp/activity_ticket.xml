<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket detail on wide screens (tablet landscape): name and timer across, code left, conditions
     and ticket data right. Same ids as layout/activity_ticket.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ticket"
    android:orientation="vertical">

    <include layout="@layout/app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">

            <!-- Name and the count-up timer (TicketDetailCountUpView): tells a live ticket from a screenshot. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/ticket_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/cTextHeading"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/counter"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_ticket_timer"
                    android:contentDescription="@string/counter_info"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="?attr/cTextHeading"
                    android:textSize="15sp"
                    tools:text="05:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="420dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                        android:id="@+id/codebox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_ticket_code"
                        android:clickable="true"
                        android:contentDescription="@string/ticket_code_spin"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">
    
                        <ImageView
                            android:id="@+id/code_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/ticket_code"
                            android:scaleType="fitCenter" />
    
                        <TextView
                            android:id="@+id/code_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textColor="#cf1322"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
    
                    <LinearLayout
                        android:id="@+id/ticket_alerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                <!-- Conditions (Deutschland-Ticket), ticket data, both after a rule; filled by TicketActivity. -->
                    <LinearLayout
                        android:id="@+id/ticket_terms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
    
                    <LinearLayout
                        android:id="@+id/ticket_kv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- "Rechnung herunterladen →": the order's invoice, kept on the device once fetched. -->
                    <TextView
                        android:id="@+id/ticket_invoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="20dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:fontFamily="sans-serif-medium"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/invoice_download"
                        android:textColor="?attr/cTextHeading"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/ticket_debug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
